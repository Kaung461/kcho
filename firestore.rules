rules_version = '2';

// Every user's study data lives under users/{uid}/... — only that signed-in
// user may read or write their own subtree. See lib/services/sync_service.dart.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
